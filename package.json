{
  "name": "product-explorer",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/infrastructure",
    "packages/app",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w @product-explorer/app",
    "build": "npm run build -w @product-explorer/app",
    "preview": "npm run preview -w @product-explorer/app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
