# Copy to .env (or .env.local) and adjust. Real .env files are git-ignored.

# Where the product data comes from:
#   mock  the fictional catalog in packages/infrastructure/src/catalog-api/mock/mock-data (default)
#   http  a catalog REST API at VITE_CATALOG_API_URL
VITE_CATALOG_ADAPTER=mock

# Base URL of the catalog REST API, only used with VITE_CATALOG_ADAPTER=http.
# The dev server forwards /api/* to it, e.g. /api/de/en/products/PRD-1001.
VITE_CATALOG_API_URL=https://api.example.com/catalog

# Website with a page per product. When set, the product shows a "View on website" button
# linking to VITE_CATALOG_SITE_URL + the product's path. Leave empty to hide the button.
VITE_CATALOG_SITE_URL=

# Simulated latency of the mock catalog in milliseconds, so loading states are visible.
VITE_MOCK_DELAY_MS=250
